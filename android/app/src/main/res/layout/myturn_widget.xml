<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyTurn con i colori del calendario: sopra il turno in corso o il prossimo, sotto i prossimi 7 giorni.
     Riempito da ShiftWidget.java (i colori dei riquadri si cambiano con setColorFilter sulle immagini di sfondo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/myturn_widget_bg">
    <FrameLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.35">
        <ImageView android:id="@+id/hero_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/hero_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.04" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/hero_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textSize="19sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/hero_hours" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum" android:layout_marginStart="8dp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/hero_progress" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:max="1000" android:visibility="gone"/>
            <Chronometer android:id="@+id/hero_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/strip" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <FrameLayout android:id="@+id/t0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="0dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/t0_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t0_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t0_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t0_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t0_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/t1_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t1_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t1_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t1_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t1_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/t2_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t2_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t2_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t2_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t2_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/t3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/t3_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t3_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t3_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t3_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t3_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/t4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/t4_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t4_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t4_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t4_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t4_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/t5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/t5_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t5_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t5_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t5_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t5_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/t6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:layout_marginEnd="0dp">
            <ImageView android:id="@+id/t6_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/t6_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/myturn_tile_ring" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/t6_wd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/t6_dn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
                <TextView android:id="@+id/t6_tm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
