<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyTurn: a sinistra oggi, a destra i prossimi giorni (riempito da ShiftWidget.java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="14dp" android:background="@drawable/myturn_widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginEnd="12dp">
        <TextView android:id="@+id/today_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/myturn_widget_muted" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:id="@+id/today_bar" android:layout_width="4dp" android:layout_height="match_parent" android:layout_marginEnd="8dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/today_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="@color/myturn_widget_ink" android:maxLines="2" android:ellipsize="end"/>
                <TextView android:id="@+id/today_hours" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="@color/myturn_widget_ink" android:maxLines="2" android:fontFeatureSettings="tnum"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/today_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textSize="11sp" android:textColor="@color/myturn_widget_muted" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:orientation="vertical">
        <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/r0_day" android:layout_width="68dp" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r0_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/r0_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/myturn_widget_ink" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r0_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:fontFeatureSettings="tnum"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/r1_day" android:layout_width="68dp" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r1_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/r1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/myturn_widget_ink" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r1_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:fontFeatureSettings="tnum"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/r2_day" android:layout_width="68dp" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r2_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/r2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/myturn_widget_ink" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r2_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:fontFeatureSettings="tnum"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/r3_day" android:layout_width="68dp" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r3_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/r3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/myturn_widget_ink" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/r3_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/myturn_widget_muted" android:fontFeatureSettings="tnum"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
